LOGGER_PRETTY_CONSOLE=true
LOGGER_LEVEL=info

HTTP_HOST=127.0.0.1
HTTP_PORT=8081
GRPC_HOST=127.0.0.1
GRPC_PORT=9081

POSTGRES_USER=otc
POSTGRES_PASSWORD=otc
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DB_NAME=identity

REDIS_ADDR=localhost:6379

# The ledger service (LedgerV1). Identity starts without it and keeps retrying to seed the house makers.
LEDGER_GRPC_ADDR=localhost:9083

# Hosted parties that sign in with an API key, "hint:key" separated by commas.
HOUSE_MAKERS=makerA:demo-key-a,makerB:demo-key-b

# How long a sign-in lasts (at least 1m), and whether the session cookie gets the Secure attribute (set it behind HTTPS).
SESSION_TTL=168h
COOKIE_SECURE=false

OTEL_SERVICE_NAME=identity
OTEL_ENDPOINT=
OTEL_NAMESPACE=
OTEL_INSTANCE_ID=
OTEL_RATIO=1.0
