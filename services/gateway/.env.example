LOGGER_PRETTY_CONSOLE=true
LOGGER_LEVEL=info

HTTP_HOST=127.0.0.1
HTTP_PORT=8080

REDIS_ADDR=localhost:6379

IDENTITY_GRPC_ADDR=localhost:9081
IDENTITY_URL=http://localhost:8081
TRADING_URL=http://localhost:8082
LEDGER_URL=http://localhost:8083

# Browser origins, besides the gateway's own, whose pages may call the API: comma-separated, exactly
# scheme://host[:port] without a path, e.g. https://<owner>.github.io for the web app on GitHub Pages.
# Empty: same-origin only (no CORS).
CORS_ORIGINS=

OTEL_SERVICE_NAME=gateway
OTEL_ENDPOINT=
OTEL_NAMESPACE=
OTEL_INSTANCE_ID=
OTEL_RATIO=1.0
