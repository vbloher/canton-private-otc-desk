# Settings of one deployment, read by docker compose from .env next to docker-compose.yml.
# Copy this file to .env on the server and fill it in; the deploy job never overwrites .env.
# An empty or missing optional value means the service's own default (see the README).

# --- Required ---------------------------------------------------------------------------------

# Postgres superuser password; takes effect when the volume is created, so set it before the first deploy.
POSTGRES_PASSWORD=

# JSON Ledger API v2 of the participant, e.g. http://host.docker.internal:6864 for one on this host.
CANTON_URL=

# House makers as hint:key pairs, e.g. makerA:<key-a>,makerB:<key-b>; the hints are the ledger's
# HOUSE_PARTIES. Use long random keys: openssl rand -hex 32.
HOUSE_MAKERS=
# The maker bot's keys, the same as above, each with its spread in basis points: <key-a>:15,<key-b>:40.
MAKER_KEYS=

# --- Optional ---------------------------------------------------------------------------------

# Port of the web app on 127.0.0.1, for the reverse proxy; give each deployment on one host its own.
WEB_PORT=3000

LOGGER_LEVEL=info
POSTGRES_USER=

# ledger
CANTON_USER_ID=
OPERATOR_HINT=
HOUSE_PARTIES=
INSTRUMENTS=
FAUCET_AMOUNTS=
ACTION_TTL=

# identity
SESSION_TTL=

# trading
FEE_BPS=
WORKER_INTERVAL=
SETTLE_TIMEOUT=

# maker-bot
PRICES_USD=
QUOTE_TTL=
POLL_INTERVAL=

# OpenTelemetry collector (OTLP); empty disables tracing.
OTEL_ENDPOINT=
OTEL_NAMESPACE=
OTEL_RATIO=
