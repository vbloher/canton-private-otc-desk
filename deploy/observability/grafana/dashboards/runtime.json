            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "go_memstats_heap_inuse_bytes{env=\"$env\",job=~\"$service\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
