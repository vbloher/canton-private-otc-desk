{
  "name": "otc-desk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../api/http/identity_v1.yaml -o src/infrastructure/api/schema/identity.d.ts && openapi-typescript ../api/http/trading_v1.yaml -o src/infrastructure/api/schema/trading.d.ts && openapi-typescript ../api/http/wallet_v1.yaml -o src/infrastructure/api/schema/wallet.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
