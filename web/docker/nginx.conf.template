# The SPA, and the gateway on the same origin: REST under /api/ and the event
# WebSocket on /api/v1/ws, so the session cookie stays first-party.
#
# Rendered at container start by the nginx image's envsubst step, which (see
# NGINX_ENVSUBST_FILTER in the Dockerfile) only fills in NGINX_LISTEN,
# NGINX_LOCAL_RESOLVERS and GATEWAY_UPSTREAM: nginx's own $variables stay.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Hashed build output is cached for good, the app shell is revalidated, and API
# answers keep whatever caching headers the gateway sends (an empty value adds none).
map $uri $otc_cache_control {
    ~^/api/     "";
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

server {
    listen ${NGINX_LISTEN};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The container's own DNS (Docker's on a compose network), asked per request:
    # a restarted gateway is found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Set here and nowhere else: a location with add_header of its own would drop them all.
    # Inline styles: React style attributes, sonner and Radix inject them. connect-src 'self'
    # covers the same-origin WebSocket.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $otc_cache_control;

    location /api/ {
        set $gateway http://${GATEWAY_UPSTREAM};
        proxy_pass $gateway;
        proxy_http_version 1.1;
        # The browser's Host, port included: the gateway's WebSocket accept compares Origin with it.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The event socket is long-lived (the gateway pings it every 30 s).
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # Every other path is a client route: serve the app and let it decide.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
