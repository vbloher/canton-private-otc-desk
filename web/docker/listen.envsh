#!/bin/sh
otc_host="${NGINX_HOST:-}"
case "$otc_host" in
    "") NGINX_LISTEN="${NGINX_PORT:-80}" ;;
    \[*) NGINX_LISTEN="${otc_host}:${NGINX_PORT:-80}" ;;
    *:*) NGINX_LISTEN="[${otc_host}]:${NGINX_PORT:-80}" ;;
    *) NGINX_LISTEN="${otc_host}:${NGINX_PORT:-80}" ;;
esac
export NGINX_LISTEN
unset otc_host

NGINX_LOCAL_RESOLVERS=$(printf '%s\n' ${NGINX_LOCAL_RESOLVERS:-} | grep -v '%' | tr '\n' ' ')
case "$(printf '%s' "$NGINX_LOCAL_RESOLVERS" | tr -d ' ')" in
    "") NGINX_LOCAL_RESOLVERS="127.0.0.1" ;;
esac
export NGINX_LOCAL_RESOLVERS
